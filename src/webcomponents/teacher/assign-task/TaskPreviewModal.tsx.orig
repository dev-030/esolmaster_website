import React, { useState } from "react";
import { Dialog, DialogContent, DialogHeader, DialogTitle } from "@/components/ui/dialog";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";

import { ProgressBar } from "@/webcomponents/sameroute/class/tasks/ProgressBar";
import { QuestionRenderer } from "@/webcomponents/sameroute/class/tasks/QuestinRenderer";
import { NavigationButtons } from "@/webcomponents/sameroute/class/tasks/NavigationButton";
import { Flashcard } from "@/webcomponents/sameroute/class/tasks/learnings/FlashcardWord";
import { GrammarContent } from "@/webcomponents/sameroute/class/tasks/learnings/GrammarContent";
import { ReadingContent } from "@/webcomponents/sameroute/class/tasks/learnings/ReadingContent";

const TASK_TYPE_META: Record<string, { label: string; emoji: string; variant: "info" | "success" | "warning" }> = {
  grammar: { label: "Grammar", emoji: "📝", variant: "info" },
  reading: { label: "Reading", emoji: "📖", variant: "success" },
  vocabulary: { label: "Vocabulary", emoji: "💬", variant: "warning" },
};

interface TaskPreviewModalProps {
  open: boolean;
  onOpenChange: (open: boolean) => void;
  taskData: {
    title: string;
    type: string;
    questions: any[];
    vocabularyItems?: any[];
    grammarContent?: any;
    readingContent?: any;
  };
}

export function TaskPreviewModal({ open, onOpenChange, taskData }: TaskPreviewModalProps) {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [answers, setAnswers] = useState<Record<string, any>>({});
  const [showLearning, setShowLearning] = useState(false);
  const [isCompleted, setIsCompleted] = useState(false);

  const meta = TASK_TYPE_META[taskData.type.toLowerCase()] || { label: taskData.type, emoji: "📝", variant: "info" };
  const questions = (taskData.questions || []).map((q, index) => ({
    id: q.id || `preview-${index}`,
    type: q.type,
    order: index + 1,
    config: {
      question: q.content,
      ...q.config
    }
  }));
  const currentQuestion = questions[currentIndex];
  const totalQuestions = questions.length;
  
  const isFirst = currentIndex === 0;
  const isLast = currentIndex === totalQuestions - 1;

  const currentAnswer = currentQuestion ? answers[currentQuestion.id] : null;

  const handleNext = () => {
    if (!isLast) setCurrentIndex(prev => prev + 1);
  };
  const handlePrev = () => {
    if (!isFirst) setCurrentIndex(prev => prev - 1);
  };
  const handleSubmit = () => {
    setIsCompleted(true);
  };

  const answeredArray = questions.map(q => answers[q.id] !== undefined && answers[q.id] !== null);

  const reset = () => {
    setCurrentIndex(0);
    setAnswers({});
    setShowLearning(false);
    setIsCompleted(false);
  };

  return (
    <Dialog open={open} onOpenChange={(val) => {
      onOpenChange(val);
      if (!val) reset();
    }}>
      <DialogContent className="max-w-4xl h-[90vh] flex flex-col p-0 gap-0 overflow-hidden bg-slate-50/50">
        <DialogHeader className="p-4 border-b bg-white flex-shrink-0">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <DialogTitle className="text-xl">{taskData.title || "Untitled Task"}</DialogTitle>
              <Badge variant={meta.variant as any} className="gap-1">
                <span>{meta.emoji}</span> {meta.label}
              </Badge>
              <Badge variant="outline" className="bg-amber-100 text-amber-800 border-amber-200">
                Preview Mode
              </Badge>
            </div>
            <Button variant="outline" size="sm" onClick={() => setShowLearning(p => !p)}>
              {showLearning ? "Back to Questions" : "Learning Section"}
            </Button>
          </div>
        </DialogHeader>

        <div className="flex-1 overflow-y-auto p-6">
          <div className="max-w-3xl mx-auto space-y-6">
            {isCompleted ? (
              <div className="bg-white p-12 rounded-xl border shadow-sm text-center space-y-4">
                <div className="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto text-3xl">🎉</div>
                <h2 className="text-2xl font-bold text-slate-800">Preview Completed!</h2>
                <p className="text-slate-500">In the real app, this would show the Result Screen with the student's score.</p>
                <Button onClick={reset} variant="outline" className="mt-4">Restart Preview</Button>
              </div>
            ) : showLearning ? (
              <div className="bg-white p-6 rounded-xl border shadow-sm">
                {taskData.type === "VOCABULARY" && (
                  <div className="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
                    {taskData.vocabularyItems?.map((item: any, idx) => (
                      <Flashcard key={item.id || idx} word={item.wordName} definition={item.definition} image={item.imageUrl} />
                    ))}
                  </div>
                )}
                {taskData.type === "GRAMMAR" && taskData.grammarContent && (
                  <GrammarContent data={taskData.grammarContent} />
                )}
                {taskData.type === "READING" && taskData.readingContent && (
                  <ReadingContent data={taskData.readingContent} />
                )}
                {(!taskData.vocabularyItems?.length && !taskData.grammarContent && !taskData.readingContent) && (
                  <div className="text-center text-slate-500 py-12">No learning content provided yet.</div>
                )}
              </div>
            ) : (
              <>
                <ProgressBar current={currentIndex} total={totalQuestions} answered={answeredArray} onNavigate={setCurrentIndex} />
                
                {currentQuestion ? (
                  <div className="bg-white p-6 rounded-xl border shadow-sm min-h-[300px]">
                    <QuestionRenderer
                      key={currentQuestion.id}
                      question={currentQuestion}
                      userAnswer={currentAnswer}
                      setAnswer={(ans) => setAnswers(prev => ({ ...prev, [currentQuestion.id]: ans }))}
                      submitted={false}
                    />
                  </div>
                ) : (
                  <div className="bg-white p-12 rounded-xl border shadow-sm text-center text-slate-500">
                    No questions added yet. Add questions to preview them here.
                  </div>
                )}

                {currentQuestion && (
                  <NavigationButtons
                    isFirst={isFirst}
                    isLast={isLast}
                    canProceed={true} 
                    onPrev={handlePrev}
                    onNext={handleNext}
                    onSubmit={handleSubmit}
                  />
                )}
              </>
            )}
          </div>
        </div>
      </DialogContent>
    </Dialog>
  );
}
